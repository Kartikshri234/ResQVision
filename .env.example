# Environment variables for ResQVision.
# Django does not read this file automatically: set these in your terminal
# (PowerShell:  $env:AI_SERVICE_API_KEY = "my-secret") or in your hosting environment.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Shared secret between Django and the AI detection service (sent as the X-API-Key header).
# Set the SAME value for the Django server and for ai_service/run_detector.py.
AI_SERVICE_API_KEY=dev-ai-key-change-me

# Where the AI service finds Django (used by ai_service/run_detector.py and send_test_event.py)
RESQVISION_API_URL=http://127.0.0.1:8000

# PostgreSQL (leave DB_NAME unset to use SQLite for local development)
# DB_NAME=resqvision
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
