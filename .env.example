# Environment variables for ResQVision.
# Loaded automatically from this file by Django and the AI service (needs: pip install python-dotenv).
# Variables already set in your terminal or hosting environment take priority over this file.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Shared secret between Django and the AI detection service (sent as the X-API-Key header).
# Set the SAME value for the Django server and for ai_service/run_detector.py.
AI_SERVICE_API_KEY=dev-ai-key-change-me

# Super admin account (used by: python manage.py create_superadmin).
# Only the super admin and other admins can create accounts - there is no public sign-up.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-to-a-strong-password

# Where the AI service finds Django (used by ai_service/run_detector.py and send_test_event.py)
RESQVISION_API_URL=http://127.0.0.1:8000

# PostgreSQL (leave DB_NAME unset to use SQLite for local development)
# DB_NAME=resqvision
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
